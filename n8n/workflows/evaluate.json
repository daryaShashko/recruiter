    {
      "parameters": {
        "jsCode": "const systemPrompt = `You are an expert IT recruiter assistant. Evaluate job postings for a Senior Software Engineer.\n\nTarget Profile: Senior/Lead/Architect, JS/TS/Node.js/React/PostgreSQL, Gdańsk OR remote.\n\nMatch if: Senior-level, Node.js/TS primary backend, Gdańsk or remote.\nReject if: Junior/Mid, primary backend Java/C#/.NET/PHP/Ruby/Go, not Gdańsk and not remote.\nIf Node.js + Java legacy both listed: match true ONLY if Node.js is listed first or described as primary.\n\nRespond ONLY with valid JSON, no markdown:\n{\"match\": true or false, \"reason\": \"one sentence\", \"url\": \"job url\"}`;\n\nreturn $input.all().map((item) => {\n  const job = item.json;\n\n  const userContent = [\n    `Job Title: ${job.title}`,\n    `Company: ${job.company}`,\n    `Location: ${job.location || 'Not specified'}`,\n    `Salary: ${job.salary || 'Not specified'}`,\n    `URL: ${job.url}`,\n    '',\n    'Job Description:',\n    job.body || 'No description available'\n  ].join('\\n');\n\n  return {\n    json: {\n      ...job,\n      ollamaBody: {\n        model: 'llama3.1:latest',\n        stream: false,\n        keep_alive: 0,\n        messages: [\n          { role: 'system', content: systemPrompt },\n          { role: 'user', content: userContent }\n        ]\n      }\n    }\n  };\n});\n"
      },
      "id": "dfc97430-4503-46a7-8ae4-4bec34aab8da",
      "name": "Code: Build Ollama Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -848,
        944
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.ollamaBody }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "e8985b37-754a-40ec-8fff-4bb704ebbac7",
      "name": "HTTP Request: Ask Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -624,
        944
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const ollamaResp = $input.first().json;\nconst job = $('Code: Build Ollama Payload').item.json;\n\nconst fallback = (reason) => ({\n  json: {\n    id: job.id,\n    title: job.title,\n    company: job.company,\n    url: job.url,\n    source: job.source,\n    location: job.location,\n    salary: job.salary,\n    tags: job.tags,\n    scrapedAt: job.scrapedAt,\n    match: false,\n    reason\n  }\n});\n\nif (ollamaResp?.error) {\n  console.log(`[Evaluate] Ollama error for ${job.url}: ${ollamaResp.error.message || 'unknown error'}`);\n  return [fallback('Ollama timeout or error')];\n}\n\nconst raw = ollamaResp?.message?.content || '';\nif (!raw) {\n  console.log(`[Evaluate] Empty Ollama response for ${job.url}`);\n  return [fallback('Empty Ollama response')];\n}\n\nlet parsed;\ntry {\n  const cleaned = raw.replace(/```json\\s*/gi, '').replace(/```\\s*/gi, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  console.log(`[Evaluate] Parse error for ${job.url}: ${raw.substring(0, 200)}`);\n  return [fallback(`Parse error: ${error.message}`)];\n}\n\nif (typeof parsed.match !== 'boolean') {\n  console.log(`[Evaluate] Bad response shape for ${job.url}: ${JSON.stringify(parsed)}`);\n  return [fallback('Bad response shape')];\n}\n\nconsole.log(`[Evaluate] ${parsed.match ? 'MATCH' : 'skip'} - ${parsed.reason}`);\n\nreturn [{\n  json: {\n    id: job.id,\n    title: job.title,\n    company: job.company,\n    url: job.url,\n    source: job.source,\n    location: job.location,\n    salary: job.salary,\n    tags: job.tags,\n    scrapedAt: job.scrapedAt,\n    match: parsed.match,\n    reason: parsed.reason\n  }\n}];\n"
      },
