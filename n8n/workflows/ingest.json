      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst raw = Array.isArray(body?.jobs) ? body.jobs : Array.isArray(body) ? body : [];\nif (raw.length === 0) return [];\nconsole.log(`[Ingest] Normalizing ${raw.length} jobs`);\nreturn raw.map(job => ({\n  json: {\n    id:        job.id        || '',\n    title:     job.title     || '',\n    company:   job.company   || '',\n    url:       job.url       || '',\n    body:      job.body      || job.jobText || job.description || '',\n    source:    job.source    || 'unknown',\n    location:  job.location  || '',\n    salary:    job.salary    || '',\n    scrapedAt: job.scrapedAt || new Date().toISOString(),\n  }\n}));"
      },
