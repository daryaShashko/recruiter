    {
      "parameters": {
        "jsCode": "const systemPrompt = `You are an expert IT recruiter assistant. Evaluate job postings for a Senior Software Engineer.\n\nTarget Profile: Senior/Lead/Architect, JS/TS/Node.js/React/PostgreSQL, Gdańsk OR remote.\n\nMatch if: Senior-level, Node.js/TS primary backend, Gdańsk or remote.\nReject if: Junior/Mid, primary backend Java/C#/.NET/PHP/Ruby/Go, not Gdańsk and not remote.\nIf Node.js + Java legacy both listed: match true ONLY if Node.js is listed first or described as primary.\n\nRespond ONLY with valid JSON, no markdown:\n{\"match\": true or false, \"reason\": \"one sentence\", \"url\": \"job url\"}`;\n\n// IMPORTANT: Notion dedup replaces $json — get original job from Split\nconst job = $('Split In Batches: 1').item.json;\n\nconst userContent = [\n  `Job Title: ${job.title}`,\n  `Company: ${job.company}`,\n  `Location: ${job.location || 'Not specified'}`,\n  `Salary: ${job.salary || 'Not specified'}`,\n  `URL: ${job.url}`,\n  '',\n  'Job Description:',\n  job.body || 'No description available'\n].join('\\n');\n\nreturn [{\n  json: {\n    ...job,\n    ollamaBody: {\n      model: 'llama3.1:latest',\n      stream: false,\n      keep_alive: 0,\n      messages: [\n        { role: 'system', content: systemPrompt },\n        { role: 'user', content: userContent }\n      ]\n    }\n  }\n}];"
      },
      "id": "dfc97430-4503-46a7-8ae4-4bec34aab8da",
