    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\n// Accept: { jobs: [...] } or bare array\nconst raw = Array.isArray(body?.jobs) ? body.jobs\n          : Array.isArray(body)       ? body\n          : [];\n\nif (raw.length === 0) {\n  console.log('[Ingest] Empty jobs array — nothing to process');\n  return [];\n}\n\nconsole.log(`[Ingest] Normalizing ${raw.length} jobs`);\n\nreturn raw.map(job => ({\n  json: {\n    id:        job.id        || '',\n    title:     job.title     || '',\n    company:   job.company   || '',\n    url:       job.url       || '',\n    body:      job.body      || job.jobText || job.description || '',\n    source:    job.source    || 'unknown',\n    location:  job.location  || '',\n    salary:    job.salary    || '',\n    tags:      Array.isArray(job.tags) ? job.tags : [],\n    scrapedAt: job.scrapedAt || new Date().toISOString(),\n  }\n}));"
      },
