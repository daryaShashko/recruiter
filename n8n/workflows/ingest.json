      "name": "HTTP Request: Ask Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [2280, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const ollamaResp = $input.first().json;\nconst job = $('Code: Build Ollama Payload').first().json;\n\nconst fallback = (reason) => ({\n  json: {\n    id: job.id, title: job.title, company: job.company,\n    url: job.url, source: job.source, location: job.location,\n    salary: job.salary, tags: job.tags, scrapedAt: job.scrapedAt,\n    match: false, reason\n  }\n});\n\nif (ollamaResp?.error) {\n  console.log(`[Evaluate] Ollama error for ${job.url}`);\n  return [fallback('Ollama timeout or error')];\n}\n\nconst raw = ollamaResp?.message?.content || '';\nif (!raw) return [fallback('Empty Ollama response')];\n\nlet parsed;\ntry {\n  const cleaned = raw.replace(/```json\\s*/gi, '').replace(/```\\s*/gi, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  return [fallback(`Parse error: ${e.message}`)];\n}\n\nif (typeof parsed.match !== 'boolean') return [fallback('Bad response shape')];\n\nconsole.log(`[Evaluate] ${parsed.match ? 'MATCH' : 'skip'} — ${parsed.reason}`);\n\nreturn [{\n  json: {\n    id: job.id, title: job.title, company: job.company,\n    url: job.url, source: job.source, location: job.location,\n    salary: job.salary, scrapedAt: job.scrapedAt,\n    match: parsed.match, reason: parsed.reason\n  }\n}];"
      },
