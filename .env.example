# n8n Webhook URL
# Local stable mode (recommended for local runs):
# WEBHOOK_URL=http://localhost:5678/webhook/jobs/ingest
# CI mode (only when GitHub Actions must reach your local n8n):
WEBHOOK_URL=https://your-tunnel-subdomain.hooks.n8n.cloud/webhook/jobs/ingest
WEBHOOK_BATCH_SIZE=25

# Notion
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Notion Evaluation Log (ADR-012, Phase 8)
NOTION_EVAL_LOG_DB_ID=36c747f7-ebec-80c8-bfd7-ed317f4a7c35
# Notion Live Control Plane (CV & Matching Criteria — auto-populated by `cd n8n && npm run notion:provision`)
NOTION_CV_DB_ID=
NOTION_CRITERIA_DB_ID=

# Telegram
TELEGRAM_BOT_TOKEN=0000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=000000000

# ── LLM Provider (ADR-016) ─────────────────────────────────
# Switch provider by changing LLM_PROVIDER and setting credentials below.
# Supported by the n8n LLM Router node: ollama | gemini | anthropic.
# (n8n/providers/ also has an openrouter adapter; it is not wired into n8n yet — P15-5.)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434    # Ollama only
LLM_MODEL=llama3.1:latest             # Default per provider:
                                       #   ollama    → llama3.1:latest
                                       #   gemini    → gemini-2.0-flash
                                       #   anthropic → claude-haiku-4-5
LLM_API_KEY=                           # Required for gemini / anthropic

