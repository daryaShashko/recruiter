# n8n Webhook URL (from tunnel)
WEBHOOK_URL=https://your-tunnel-subdomain.hooks.n8n.cloud/webhook/jobs/ingest
WEBHOOK_BATCH_SIZE=25

# Ollama (optional, for local testing)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Gemini Flash API key — for llm-rubric assertions in promptfoo eval (P10-5)
# Free tier available at: aistudio.google.com
# If not set, llm-rubric assertions are automatically skipped.
GOOGLE_API_KEY=           # Gemini Flash API key (free tier at aistudio.google.com) — для P10-5 llm-rubric assertions
