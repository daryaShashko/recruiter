{
  "name": "ai-recruiter-scraper",
  "version": "1.0.0",
  "description": "Playwright-based scraper for IT job boards with Cloudflare bypass",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "scrape": "ts-node src/index.ts",
    "scrape:dry": "DRY_RUN=true ts-node src/index.ts",
    "scrape:watch": "HEADLESS=false DRY_RUN=true ts-node src/index.ts",
    "test": "jest",
    "test:integration": "RUN_INTEGRATION=1 jest tests/justjoin.test.ts tests/nofluffjobs.test.ts tests/e2e.test.ts",
    "test:justjoin": "RUN_INTEGRATION=1 jest tests/justjoin.test.ts",
    "test:nofluffjobs": "RUN_INTEGRATION=1 jest tests/nofluffjobs.test.ts",
    "test:e2e": "RUN_INTEGRATION=1 jest tests/e2e.test.ts",
    "typecheck": "tsc --noEmit",
    "eval": "npx promptfoo eval -c ../n8n/prompts/promptfooconfig.yaml",
    "eval:full": "npx promptfoo eval -c ../n8n/prompts/promptfooconfig-gemini.yaml --tests ../n8n/prompts/rubric_dataset.yaml --providers google:gemini-3.1-flash-lite",
    "eval:view": "npx promptfoo view",
    "eval:gemini": "npx promptfoo eval -c ../n8n/prompts/promptfooconfig-gemini.yaml",
    "eval:gemini:view": "npx promptfoo view",
    "eval:smoke": "npx promptfoo eval -c ../n8n/prompts/promptfooconfig-smoke.yaml",
    "check": "ts-node src/check-manual.ts",
    "generate:cv": "ts-node src/generator/cli.ts --target cv --dry-run",
    "generate:letter": "ts-node src/generator/cli.ts --target letter --dry-run",
    "apply:dry": "ts-node src/generator/cli.ts --dry-run",
    "demo:hitl": "ts-node src/demo-hitl.ts"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "playwright": "^1.45.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "jest": "^29.7.0",
    "promptfoo": "^0.121.12",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 60000,
    "roots": ["<rootDir>", "<rootDir>/../n8n"]
  }
}
